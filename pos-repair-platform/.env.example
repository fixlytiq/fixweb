# Database Configuration
# Local Postgres (Docker / native):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=pos_repair_platform
POSTGRES_PORT=5433

# Cloud SQL (Explicit Socket Path) - host param points to .s.PGSQL.5432 to avoid driver appending :5432
# DATABASE_URL=postgresql://USER:PASSWORD@localhost/pos_repair_platform?host=/cloudsql/repair-pos-485101:us-central1:pos-repair-postgres/.s.PGSQL.5432
# For Cloud SQL Proxy locally: postgresql://USER:PASSWORD@127.0.0.1:5432/pos_repair_platform

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# API Configuration
API_PORT=3000
JWT_SECRET=your-secret-key-change-in-production
FRONTEND_URL=http://localhost:3001,http://localhost:3002
NODE_ENV=development

# Web Application
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# Owner Portal
OWNER_PORT=3002

# Twilio SMS Configuration (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
